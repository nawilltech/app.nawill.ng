NODE_ENV=development
# 4000, not 3000 — leaves 3000 free for `pnpm --filter @nawill/web dev`'s default port.
PORT=4000

# Local Postgres, trust-auth as the current OS user (matches this machine's setup)
DATABASE_URL="postgresql://<your-os-username>@localhost:5432/nawill_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="7d"

MOCK_PROCESSOR_WEBHOOK_SECRET="dev-mock-processor-secret"

# Only enforced when NODE_ENV=production; /api/docs is open in dev/test
SWAGGER_USER="admin"
SWAGGER_PASSWORD="change-me"

# Optional — omit to use the built-in deterministic mock resolver (see docs/ARCHITECTURE.md §7.8)
PAYSTACK_SECRET_KEY=

# Idempotent super-admin seed (see prisma/seed.ts) — change before running against a shared env
SUPER_ADMIN_EMAIL="admin@nawill.ng"
SUPER_ADMIN_PASSWORD="Change-Me-Now9!"
